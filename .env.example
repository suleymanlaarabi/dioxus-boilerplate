DATABASE_URL=postgres://boilerplate:boilerplate@127.0.0.1:5432/boilerplate
# Local HTTP development only. Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
RESEND=example
# Local development uses the Resend test sender (only your Resend account address can receive).
# Set an address on your verified domain to send to other recipients.
RESEND_FROM=onboarding@resend.dev
# make dev sets this from APP_PORT; change it here when launching the server directly.
APP_URL=http://localhost:8080
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=boilerplate-files
RUSTFS_ACCESS_KEY=boilerplate
RUSTFS_SECRET_KEY=boilerplate-local-storage-secret
